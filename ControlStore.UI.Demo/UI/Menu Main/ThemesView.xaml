<Page x:Class="ControlStore.UI.Demo.UI.Menu_Main.ThemesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ControlStore.UI.Demo.UI.Menu_Main"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ThemesView">

    <Page.Resources>

        <Style TargetType="{x:Type TextBox}" x:Key="CopyTextStyle">

            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="SelectionBrush" Value="#DEEBFF"/>
            <Setter Property="Foreground" Value="Black"/>


        </Style>
    </Page.Resources>

    <Grid>
        <ScrollViewer>

            <StackPanel>

                <TextBlock Text="Colores Base" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="10" Width="auto" Height="45" CornerRadius="4"
                            Background="{StaticResource ControlStore.Base.MainFund}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                 Style="{StaticResource CopyTextStyle}" Text="#FFFFFF"/>
                    </Border>

                    <Border Grid.Column="1" Margin="10" Width="auto" Height="45" CornerRadius="4"
                            Background="{StaticResource ControlStore.Base.SecondaryFund}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                 Style="{StaticResource CopyTextStyle}" Text="#F4F5F7"/>
                    </Border>

                    <Border Grid.Column="2" Margin="10" Width="auto" Height="45" CornerRadius="4"
                            Background="{StaticResource ControlStore.Base.MainText}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"
                        Style="{StaticResource CopyTextStyle}" Text="#172B4D"/>
                    </Border>

                    <Border Grid.Column="3" Margin="10" Width="auto" Height="45" CornerRadius="4"
                            Background="{StaticResource ControlStore.Base.SecondaryText}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"
                                 Style="{StaticResource CopyTextStyle}" Text="#6B778C"/>
                    </Border>

                    <Border Grid.Column="4" Margin="10" Width="auto" Height="45" CornerRadius="4"
                            Background="{StaticResource ControlStore.Base.MainBorder}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                 Style="{StaticResource CopyTextStyle}" Text="#DFE1E6"/>
                    </Border>
                    
                </Grid>

                <TextBlock Text="Colores de Acento y Acción" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="10" Width="auto" Height="45" CornerRadius="4"
                           Background="{StaticResource ControlStore.Action.MainBlue}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                 Style="{StaticResource CopyTextStyle}" Text="#0052CC"/>
                    </Border>

                    <Border Grid.Column="1" Margin="10" Width="auto" Height="45" CornerRadius="4"
                            Background="{StaticResource ControlStore.Action.InteractiveBlue}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                 Style="{StaticResource CopyTextStyle}" Text="#0047B3"/>
                    </Border>

                    <Border Grid.Column="2" Margin="10" Width="auto" Height="45" CornerRadius="4"
                            Background="{StaticResource ControlStore.Action.SoftBlue}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                 Style="{StaticResource CopyTextStyle}" Text="#DEEBFF"/>
                    </Border>


                </Grid>


                <TextBlock Text="Colores de Estado" HorizontalAlignment="Center" VerticalAlignment="Top"/>

                <Grid>

                    <Grid.ColumnDefinitions>

                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="10" Width="auto" Height="45" Background="{StaticResource ControlStore.State.Success}" CornerRadius="4"/>
                    <Border Grid.Column="1" Margin="10" Width="auto" Height="45" Background="{StaticResource ControlStore.State.Errors}" CornerRadius="4"/>
                    <Border Grid.Column="2" Margin="10" Width="auto" Height="45" Background="{StaticResource ControlStore.State.Warding}" CornerRadius="4"/>

                    <Border Grid.Column="0" Margin="10" Width="auto" Height="45" CornerRadius="4"
                           Background="{StaticResource ControlStore.State.Success}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                 Style="{StaticResource CopyTextStyle}" Text="#00875A"/>
                    </Border>

                    <Border Grid.Column="1" Margin="10" Width="auto" Height="45" CornerRadius="4"
                            Background="{StaticResource ControlStore.State.Errors}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                 Style="{StaticResource CopyTextStyle}" Text="#DE350B"/>
                    </Border>

                    <Border Grid.Column="2" Margin="10" Width="auto" Height="45" CornerRadius="4"
                            Background="{StaticResource ControlStore.State.Warding}">
                        <TextBox HorizontalAlignment="Center" VerticalAlignment="Center" 
                                 Style="{StaticResource CopyTextStyle}" Text="#FF991F"/>
                    </Border>

                </Grid>

            </StackPanel>

        </ScrollViewer>
    </Grid>
</Page>

<Page x:Class="ControlStore.UI.Demo.UI.Menu_Main.BusinessCardControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ControlStore.UI.Demo.UI.Menu_Main"
      xmlns:controls="clr-namespace:ControlStore.UI.Controls;assembly=ControlStore.UI"
      mc:Ignorable="d" Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="BusinessCardControl">

    <Grid>

        <StackPanel>

            <TextBlock Margin="10" HorizontalAlignment="Center" Style="{StaticResource PrimaryText}"
                       FontSize="24" FontWeight="SemiBold" Text="Carta de Inicio y Presentacion"/>

            <controls:InformationCard Width="400" Height="220" Margin="10" ScaleInformation="1.2"
                                      Icon="ABCOff" TitleText="Control de Productos"
                                      DescriptionText="Registrar, editar, consultar y desacticvar productos facilmente en el catalogo."/>


        </StackPanel>

    </Grid>
</Page>

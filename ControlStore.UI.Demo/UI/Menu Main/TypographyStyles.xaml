<Page x:Class="ControlStore.UI.Demo.UI.Menu_Main.TypographyStyles"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ControlStore.UI.Demo.UI.Menu_Main"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TypographyStyles" Background="White">

    <Grid>

        <StackPanel HorizontalAlignment="Center">

            <TextBlock Style="{StaticResource PrimaryText}" Text="Texto Principal" FontSize="30" Margin="10"/>

            <TextBlock Style="{StaticResource SecondaryText}" Text="Texto Secundario" FontSize="30" Margin="10"/>

            <TextBlock Style="{StaticResource TertiaryText}" Text="Texto Terciario..." FontSize="30" Margin="10"/>

        </StackPanel>
        
    </Grid>
</Page>

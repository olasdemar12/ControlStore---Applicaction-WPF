<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PrimaryText" TargetType="{x:Type TextBlock}" >
        <Setter Property="Foreground" Value="{StaticResource ControlStore.Base.MainText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontStyle" Value="Normal"/>
    </Style>

    <Style x:Key="SecondaryText" TargetType="{x:Type TextBlock}" >
        <Setter Property="Foreground" Value="{StaticResource ControlStore.Base.SecondaryText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontStyle" Value="Normal"/>
    </Style>

    <Style x:Key="TertiaryText" TargetType="{x:Type TextBlock}" >
        <Setter Property="Foreground" Value="{StaticResource ControlStore.Base.SecondaryText}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontStyle" Value="Italic"/>
    </Style>

</ResourceDictionary>
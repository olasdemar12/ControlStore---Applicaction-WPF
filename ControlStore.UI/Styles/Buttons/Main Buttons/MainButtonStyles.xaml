<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type Button}">
        
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Background" Value="{StaticResource ControlStore.Action.MainBlue}"/>
        <Setter Property="Foreground" Value="{StaticResource ControlStore.Base.MainFund}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ControlStore.Action.MainBlue}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                
                <ControlTemplate TargetType="{x:Type Button}">
                    
                    <Border  x:Name="OuterBorder"
                             Background="{TemplateBinding BorderBrush}"
                             CornerRadius="6"
                             SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0.5">

                        <Border.RenderTransform>
                            <ScaleTransform
                            x:Name="ButtonScale"
                            ScaleX="1"
                            ScaleY="1"/>
                        </Border.RenderTransform>

                        <Border.Effect>
                            <DropShadowEffect
                                x:Name="ShadowEffectBorder"
                                Color="#DEEBFF"
                                BlurRadius="0"
                                ShadowDepth="0"
                                Opacity="0"/>
                        </Border.Effect>

                        <Border x:Name="InnerBorder"
                                Margin="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" 
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                        </Border>
                        
                    </Border>

                    <ControlTemplate.Triggers>
                        
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="InnerBorder" Property="Background" Value="{StaticResource ControlStore.Action.InteractiveBlue}"/>
                        </Trigger>

                        <!-- Efecto Difuminado al colocar el cursor -->
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetName="ShadowEffectBorder"
                                    Storyboard.TargetProperty="(DropShadowEffect.BlurRadius)"
                                    To="20"
                                    Duration="0:0:0.25">

                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>

                                    <DoubleAnimation
                                        Storyboard.TargetName="ShadowEffectBorder"
                        Storyboard.TargetProperty="(DropShadowEffect.Opacity)"
                        To="1"
                        Duration="0:0:0.25"/>

                                    <ColorAnimation
                                Storyboard.TargetName="OuterBorder"
                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                To="#0052CC"
                                Duration="0:0:0.25"/>

                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <!-- Al retirar el cursor -->
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>

                                    <DoubleAnimation
                                        Storyboard.TargetName="ShadowEffectBorder"
                                    Storyboard.TargetProperty="(DropShadowEffect.BlurRadius)"
                                    To="0"
                                    Duration="0:0:0.25">

                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseIn"/>
                                        </DoubleAnimation.EasingFunction>

                                    </DoubleAnimation>

                                    <DoubleAnimation
                                        Storyboard.TargetName="ShadowEffectBorder"
                        Storyboard.TargetProperty="(DropShadowEffect.Opacity)"
                        To="0"
                        Duration="0:0:0.25"/>

                                    <ColorAnimation
                                Storyboard.TargetName="OuterBorder"
                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                To="#0052CC"
                                Duration="0:0:0.25"/>

                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>


                        <Trigger Property="IsPressed" Value="True">
                            <!-- Al Presionar el Boton-->
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation
                                        Storyboard.TargetName="ButtonScale"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="0.96"
                                        Duration="0:0:0.09">

                                            <!--Curvatura de Animacion EN X-->
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation
                                        Storyboard.TargetName="ButtonScale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="0.96"
                                        Duration="0:0:0.09">

                                            <!--Curvatura de Animacion EN Y-->
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <!-- Al dejar de presionar el Boton-->
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation
                                        Storyboard.TargetName="ButtonScale"
                                        Storyboard.TargetProperty="ScaleX"
                                        To="1"
                                        Duration="0:0:0.12">


                                            <!--Curvatura de Animacion EN X-->
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation
                                        Storyboard.TargetName="ButtonScale"
                                        Storyboard.TargetProperty="ScaleY"
                                        To="1"
                                        Duration="0:0:0.12">

                                            <!--Curvatura de Animacion EN Y-->
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            
                        </Trigger>


                        
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
                
            </Setter.Value>
        </Setter> 

    </Style>



<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <ResourceDictionary.MergedDictionaries>

        <materialDesign:BundledTheme BaseTheme="Light" 
                                     PrimaryColor="Blue" 
                                     SecondaryColor="LightBlue" />
        <ResourceDictionary
            Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>

    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush
        x:Key="ControlStore.Base.MainFund"
        Color="#FFFFFF" />

    <SolidColorBrush
        x:Key="ControlStore.Base.SecondaryFund"
        Color="#F4F5F7" />

    <SolidColorBrush
        x:Key="ControlStore.Base.MainText"
        Color="#172B4D" />

    <SolidColorBrush
        x:Key="ControlStore.Base.SecondaryText"
        Color="#6B778C" />

    <SolidColorBrush
        x:Key="ControlStore.Base.MainBorder"
        Color="#DFE1E6" />

    <SolidColorBrush
        x:Key="ControlStore.Action.MainBlue"
        Color="#0052CC" />

    <SolidColorBrush
        x:Key="ControlStore.Action.InteractiveBlue"
        Color="#0047B3" />

    <SolidColorBrush
        x:Key="ControlStore.Action.SoftBlue"
        Color="#DEEBFF" />

    <SolidColorBrush
        x:Key="ControlStore.State.Success"
        Color="#00875A" />

    <SolidColorBrush
        x:Key="ControlStore.State.Errors"
        Color="#DE350B" />

    <SolidColorBrush
        x:Key="ControlStore.State.Warding"
        Color="#FF991F" />

</ResourceDictionary>
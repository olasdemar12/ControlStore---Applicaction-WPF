<UserControl x:Class="ControlStore.UI.Controls.ButtonIconText"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControlStore.UI.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" MinWidth="100" MinHeight="45" x:Name="Root">
    <Button Style="{Binding StyleButton, ElementName=Root}"
            Width="{Binding Width,ElementName=Root}" Height="{Binding Height,ElementName=Root}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <materialDesign:PackIcon Kind="{Binding IconButton, ElementName=Root}" VerticalAlignment="Center"
                                     Width="{Binding IconSize, ElementName=Root}" Height="{Binding IconSize, ElementName=Root}" Margin="10,0,5,0"/>
            <TextBlock Text="{Binding TextButton, ElementName=Root}" VerticalAlignment="Center" Margin="0,0,15,0"/>
        </StackPanel>
    </Button>
</UserControl>

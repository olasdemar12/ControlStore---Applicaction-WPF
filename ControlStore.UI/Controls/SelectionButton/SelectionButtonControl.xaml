<UserControl x:Class="ControlStore.UI.Controls.SelectionButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ControlStore.UI.Controls"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" MinWidth="320" MinHeight="180" x:Name="Root">
    <UserControl.Resources>
        <Style TargetType="{x:Type CheckBox}" x:Key="SelectionButtonStyle">
            <Setter Property="Background" Value="{StaticResource ControlStore.Base.MainFund}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlStore.Base.MainBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsChecked" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="TemplateBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border.Effect>
                                <DropShadowEffect
                                 Color="#DEEBFF"
                                 BlurRadius="0"
                                 ShadowDepth="0"
                                 Opacity="0"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>

                            <!-- Al colocar el cursor -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="TemplateBorder"
                                    Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                    To="10"
                                    Duration="0:0:0.25">

                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>

                                        <DoubleAnimation Storyboard.TargetName="TemplateBorder"
                        Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                        To="0.65"
                        Duration="0:0:0.25"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>

                            <!-- Al retirar el cursor -->
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>

                                        <DoubleAnimation Storyboard.TargetName="TemplateBorder"
                                    Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                    To="0"
                                    Duration="0:0:0.25">

                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>

                                        </DoubleAnimation>

                                        <DoubleAnimation Storyboard.TargetName="TemplateBorder"
                        Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                        To="0"
                        Duration="0:0:0.25"/>

                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            
                            <!--Color que toma el borde al seleccionar el checkBox-->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TemplateBorder" Property="Background" Value="{StaticResource ControlStore.Base.MainFund}"/>
                                <Setter TargetName="TemplateBorder" Property="BorderBrush" Value="#0052CC"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
    </UserControl.Resources>
    
    <CheckBox Style="{StaticResource SelectionButtonStyle}" IsChecked="{Binding IsCheck, ElementName=Root}" Command="{Binding Command,ElementName=Root}">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MaxWidth="400" MaxHeight="260" RenderTransformOrigin="0.5,0.5">
            
            <Grid.RenderTransform>
                <ScaleTransform ScaleX="{Binding ScaleInformation, ElementName=Root}" ScaleY="{Binding ScaleInformation, ElementName=Root}"/>
            </Grid.RenderTransform>

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Width="50" Height="{Binding Width, RelativeSource={RelativeSource Self}}"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,0,0"
                   Background="{StaticResource ControlStore.Action.SoftBlue}"
                   CornerRadius="10">
                <materialDesign:PackIcon Kind="{Binding Icon, ElementName=Root}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Foreground="{StaticResource ControlStore.Action.MainBlue}"
                                        Height="auto" Width="auto" Margin="10"/>
            </Border>

            <TextBlock Grid.Row="1" Text="{Binding TitleText, ElementName=Root}" FontWeight="SemiBold" Style="{StaticResource PrimaryText}"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" FontSize="22" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2" Text="{Binding DescriptionText, ElementName=Root}" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                      HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,10,0,0" FontSize="16"/>

        </Grid>
    </CheckBox>
</UserControl>

<Window x:Class="ControlStore.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ControlStore.Desktop"
        xmlns:controls="clr-namespace:ControlStore.UI.Controls;assembly=ControlStore.UI"
        Style="{StaticResource WindowsFloatingStyle}"
        WindowStartupLocation="CenterScreen">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--Logotipo de Control Store-->
        <controls:IconPrimaryControlStore Grid.Row="0" Margin="130,50,0,30" IconSize="2" HorizontalAlignment="Left"/>
        <!--Sub titulo: "objetivos principales"-->
        <TextBlock Text="Objetivos Principales." Grid.Row="1" Margin="40,0,0,30" Style="{StaticResource PrimaryText}" FontSize="30"/>
        <!--Contenido principal-->
        <Grid Grid.Row="2" Margin="30,0,30,30">
            <!--Filas-->
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!--Columnas-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!--Contenido de la Fila 1 -->

            <controls:InformationCard Grid.Row="0" Grid.Column="0" Margin="10" ScaleInformation="1"
                                      Icon="ABCOff" TitleText="Control de Productos"
                                      DescriptionText="Registrar, editar, consultar y desacticvar productos fácilmente en el catálogo."/>

            <controls:InformationCard Grid.Row="0" Grid.Column="1" Margin="10" ScaleInformation="1"
                                      Icon="ABCOff" TitleText="Gestionar inventario"
                                      DescriptionText="Administrar eficientemente las existencias tanto en almacén como en piso de venta."/>

            <controls:InformationCard Grid.Row="0" Grid.Column="2" Margin="10" ScaleInformation="1"
                                      Icon="ABCOff" TitleText="Registrar ventas"
                                      DescriptionText="Llevar el control total de ventas, aperturas de cajas y movimientos relacionados."/>

            <!--Contenido de la Fila 2 -->

            <controls:InformationCard Grid.Row="1" Grid.Column="0" Margin="10" ScaleInformation="1"
                                      Icon="ABCOff" TitleText="Administrar usuarios"
                                      DescriptionText="Definir accesos de forma segura y granular según el rol de cada usuario."/>

            <controls:InformationCard Grid.Row="1" Grid.Column="1" Margin="10" ScaleInformation="1"
                                      Icon="ABCOff" TitleText="Generar reportes"
                                      DescriptionText="Ofrecer información precisa, exportable y útil para la toma de decisiones."/>

            <controls:InformationCard Grid.Row="1" Grid.Column="2" Margin="10" ScaleInformation="1"
                                      Icon="ABCOff" TitleText="Centralizar operación"
                                      DescriptionText="Conectar los módulos principales del negocio en un solo ecosistema integral."/>
        </Grid>
        <!--Boton para avanzar a la siguiente pantalla-->
        <Button Grid.Row="3" Style="{StaticResource PrimaryButtonStyle}" Width="180" Height="50" FontSize="20" Content="Siguiente" 
                HorizontalAlignment="Right" Margin="0,0,30,30" Click="Button_Click"/>

    </Grid>
</Window>
